{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "PowerShell(npx tsc --noEmit*)",
      "PowerShell(npm run typecheck*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npm test*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "ask": [
      "PowerShell(git push*)",
      "PowerShell(git reset*)",
      "PowerShell(git clean*)",
      "PowerShell(git rebase*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(eas *)",
      "PowerShell(npx eas-cli*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "PowerShell(npm audit fix --force*)"
    ]
  }
}
